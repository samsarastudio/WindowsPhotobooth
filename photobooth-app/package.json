{
  "name": "photobooth-app",
  "version": "1.1.6",
  "description": "PhotoBooth — Electron + Angular + Canon EDSDK",
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "npm run build && electron-builder --win portable && node scripts/package-deploy.cjs",
    "electron:build:folder": "npm run build && electron-builder --win dir && node scripts/package-deploy.cjs",
    "package:deploy": "node scripts/package-deploy.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "form-data": "^4.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sharp": "^0.33.5",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.25",
    "@angular/cli": "^19.2.25",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.photobooth.app",
    "productName": "PhotoBooth",
    "asarUnpack": [
      "**/node_modules/sharp/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "themes/**/*",
      "config/**/*",
      "theme-template/**/*"
    ],
    "extraFiles": [
      {
        "from": "bin",
        "to": ".",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "themes",
        "to": "themes"
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "theme-template",
        "to": "theme-template"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PhotoBooth-Portable-${version}.exe",
      "unpackDirName": "PhotoBooth"
    }
  }
}
