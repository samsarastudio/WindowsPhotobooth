[Unit]
Description=InMoment Moments gallery server
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/moments-server
Environment=NODE_ENV=production
EnvironmentFile=/home/pi/moments-server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

# Do not use ports 3000, 3001, or 5000 — set PORT=3020 in .env
# Run this unit OR PM2, not both. Two supervisors fighting over 3020
# causes an EADDRINUSE crash loop.

[Install]
WantedBy=multi-user.target
