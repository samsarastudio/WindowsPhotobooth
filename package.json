{
  "name": "moments-server",
  "version": "1.0.0",
  "private": true,
  "description": "InMoment photo gallery server for photobooth sessions",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start:live": "node src/live/index.js",
    "test:live": "node --test test/live.test.mjs test/live-features.test.mjs test/live-admin.test.mjs test/live-wall.test.mjs test/live-print.test.mjs test/live-album-layout.test.mjs test/live-photobooth.test.mjs",
    "test:live:browser": "node scripts/test-live-browser.cjs",
    "test:live:wall": "node scripts/test-live-wall-browser.cjs",
    "test:live:camera": "node scripts/test-live-camera-layout.cjs",
    "build:live:icons": "node scripts/build-live-icons.mjs",
    "start": "node src/index.js",
    "dev": "node --watch-path=src --watch-path=public src/index.js",
    "purge": "node src/purge-cli.js",
    "qa:share": "node scripts/qa-share.mjs",
    "test:physical-frame": "node --test test/physical-frame.test.mjs",
    "test:game": "node --test test/game.test.mjs",
    "test:game:browser": "node scripts/test-game-browser.cjs",
    "test:game:unity": "node scripts/test-game-unity.cjs",
    "seed": "node -e \"import('./src/db.js').then(async m=>{m.initDb(); const {seedSampleGallery}=await import('./src/seed-samples.js'); console.log(JSON.stringify(seedSampleGallery(),null,2))})\"",
    "build:game-admin": "node scripts/build-game-admin.mjs",
    "test:live:print": "node scripts/test-live-print-browser.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "multer": "^2.2.0",
    "nanoid": "^5.1.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@angular/common": "19.2.21",
    "@angular/compiler": "19.2.21",
    "@angular/compiler-cli": "19.2.21",
    "@angular/core": "19.2.21",
    "@angular/platform-browser": "19.2.21",
    "@babel/core": "7.26.9",
    "esbuild": "0.28.0",
    "typescript": "5.7.3"
  }
}
