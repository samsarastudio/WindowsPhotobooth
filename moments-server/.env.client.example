# In Moment Client Gallery: independent from Moments Gallery and Moments Live.
CLIENT_PORT=3022
CLIENT_HOST=127.0.0.1
CLIENT_PUBLIC_URL=https://client.inmomentservices.com
CLIENT_DATA_DIR=/var/lib/moments-client
CLIENT_SECURE_COOKIES=true

# Required. Use a unique password of at least 12 characters.
CLIENT_ADMIN_PASSWORD=
# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable across restarts. Changing it invalidates signed sessions.
CLIENT_SESSION_SECRET=

# Optional SMTP delivery. Leave unset until a real provider is configured.
# CLIENT_SMTP_HOST=smtp.example.com
# CLIENT_SMTP_PORT=587
# CLIENT_SMTP_USER=
# CLIENT_SMTP_PASS=
# CLIENT_SMTP_FROM=In Moment <photos@inmomentservices.com>
