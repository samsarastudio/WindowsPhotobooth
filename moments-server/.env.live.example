# Independent from the existing Moments Gallery .env / database.
LIVE_PORT=3021
LIVE_HOST=127.0.0.1
LIVE_BASE_URL=https://live.inmomentservices.com
LIVE_DATA_DIR=/var/lib/moments-live
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVE_ADMIN_KEY=

# Optional: without SMTP, /admin creates a one-time link to share manually.
# Use your provider's authenticated SMTP URL; percent-encode special password characters.
# LIVE_SMTP_URL=smtps://username:password@smtp.example.com:465
# LIVE_MAIL_FROM=Moments Live <events@inmomentservices.com>

# Apple Developer Team ID (10 characters), after registering the app and App Clip.
# LIVE_APPLE_TEAM_ID=
LIVE_IOS_BUNDLE_ID=com.inmomentservices.live
# Google Play Console > App integrity > App signing key certificate > SHA-256
# Comma-separate fingerprints if using several active signing certificates.
# LIVE_ANDROID_SHA256=
LIVE_ANDROID_PACKAGE=com.inmomentservices.live
