# Bind on Pi — do NOT use 3000, 3001, or 5000 (already taken).
PORT=3020
HOST=127.0.0.1
# Set HTTPS=1 for LAN phone camera (self-signed cert in data/certs)
# HTTPS=1

# Public URL used in share links / QR codes (optional — defaults to production host below)
PUBLIC_BASE_URL=https://moments.inmomentservices.com

# Fallback when PUBLIC_BASE_URL is unset or localhost (Pi default)
# PRODUCTION_PUBLIC_BASE_URL=https://moments.inmomentservices.com

# Set to 1 only on a dev machine to allow localhost in share/QR URLs
# ALLOW_LOCAL_PUBLIC_URL=1

# Booth upload auth (Authorization: Bearer <token> or X-Moments-Token)
UPLOAD_TOKEN=change-me-to-a-long-random-string

# Gallery admin PIN (X-Admin-Pin header)
ADMIN_PIN=2727

# Default session lifetime when booth creates a day session
DEFAULT_TTL_DAYS=30

# Optional absolute paths (default: ./data next to package)
# DATA_DIR=/var/lib/moments-gallery
